@model IEnumerable<ProductsAPI.Models.Product>
@using ProductsAPI.Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product List</title>
    <style>
        /* Global styles */
        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
        }

        /* Table styles */
        table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #ccc;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
            color: #333;
        }

        tr:hover {
            background-color: #f5f5f5;
        }

        /* Pagination styles */
        .pagination {
            margin-top: 20px;
            text-align: center;
        }

            .pagination button {
                padding: 10px 15px;
                margin: 0 5px;
                border: none;
                border-radius: 5px;
                background-color: #4CAF50;
                color: #fff;
                cursor: pointer;
            }

                .pagination button:hover {
                    background-color: #3e8e41;
                }

        /* Title styles */
        .title {
            text-align: center;
            margin-bottom: 20px;
            font-size: 24px;
            font-weight: bold;
            color: #333;
            text-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        }

        .title-icon {
            display: inline-block;
            width: 40px;
            height: 40px;
            margin-right: 10px;
            background-size: cover;
            background-position: center;
            background-image: url('https://example.com/icon.png');
        }

        /* Search bar styles */
        .search-bar {
            margin-bottom: 20px;
            text-align: center;
        }

            .search-bar input[type="text"] {
                padding: 10px;
                width: 300px;
                border: 1px solid #ccc;
                border-radius: 5px;
            }

            .search-bar button {
                padding: 10px 15px;
                border: none;
                border-radius: 5px;
                background-color: #4CAF50;
                color: white;
                cursor: pointer;
            }

                .search-bar button:hover {
                    background-color: #3e8e41;
                }
    </style>
</head>
<body>
    <h1 class="title">
        <span class="title-icon"></span>
        Product List
    </h1>

    <!-- Search bar -->
    <div class="search-bar">
        <form method="get" action="/Home/Index">
            <input type="text" name="searchQuery" placeholder="Tìm sản phẩm..." value="@ViewBag.CurrentSearchQuery" />
            <button type="submit">Tìm kiếm</button>
        </form>
    </div>

    <table>
        <tr>
            <th>ID</th>
            <th>Code</th>
            <th>Name</th>
            <th>Category</th>
            <th>Brand</th>
            <th>Type</th>
            <th>Description</th>
        </tr>
        @if (Model != null && Model.Any())
        {
            foreach (var product in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(m => product.Id)</td>
                    <td>@Html.DisplayFor(m => product.Code)</td>
                    <td>@Html.DisplayFor(m => product.Name)</td>
                    <td>@Html.DisplayFor(m => product.Category)</td>
                    <td>@Html.DisplayFor(m => product.Brand)</td>
                    <td>@Html.DisplayFor(m => product.Type)</td>
                    <td>@Html.DisplayFor(m => product.Description)</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7">No products available.</td>
            </tr>
        }
    </table>

    <div class="pagination">
        @if (ViewBag.CurrentPage > 1)
        {
            <button onclick="location.href='?page=1&searchQuery=@ViewBag.CurrentSearchQuery'">First</button>
            <button onclick="location.href='?page=@(ViewBag.CurrentPage - 1)&searchQuery=@ViewBag.CurrentSearchQuery'">Previous</button>
        }

        <span>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <button onclick="location.href='?page=@(ViewBag.CurrentPage + 1)&searchQuery=@ViewBag.CurrentSearchQuery'">Next</button>
            <button onclick="location.href='?page=@ViewBag.TotalPages&searchQuery=@ViewBag.CurrentSearchQuery'">Last</button>
        }
    </div>
</body>
</html>
